<launch>
  <!-- 机器人初始位置参数 -->
  <arg name="x_pos" default="1.7"/>
  <arg name="y_pos" default="1.7"/>
  <arg name="z_pos" default="0.001"/>
  <arg name="yaw_pos" default="3.14159"/>

  <env name="GAZEBO_MODEL_PATH" value="$(find robotcar_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <arg name="world_file" default="$(find robotcar_gazebo)/worlds/map_world.world"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="teleop" default="true"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- 启动 Gazebo Server -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find robotcar_gazebo)/worlds/map_world.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- 加载机器人模型 -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find robotcar_gazebo)/urdf/robotcar.urdf.xacro'"/>
  
  <!-- 在 Gazebo 中 spawn 机器人 -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-urdf -model robotcar -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -Y $(arg yaw_pos) -param robot_description" />
  
  <!-- 启动 robot_state_publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

</launch>
