  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin rpy="0 0 0" xyz="-0.1295 -0.1355 0.0375"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- 相机（深度相机：单目结构光，使用 gazebo 深度相机插件模拟） -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.037"/>
      </geometry>
      <material name="Blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <!-- 相机不被机身遮挡：中心相对前缘内缩 camera_length/2 -->
    <origin rpy="0 0 0" xyz="0.1545 0 0.0785"/>
    <child link="camera_link"/>
  </joint>
  <!-- 雷达（360°，位于顶部，距前端 lidar_offset_from_front） -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.025"/>
      </geometry>
      <material name="Red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <!-- 雷达位于顶部，沿前端向内偏置 lidar_offset_from_front -->
    <origin rpy="0 0 0" xyz="0.072 0 0.2"/>
    <child link="lidar_link"/>
  </joint>
  <!-- Gazebo 材质与传感器、控制插件 -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <turnGravityOff>false</turnGravityOff>
  </gazebo>
  <!-- 激光雷达插件（360°, 10m, 5-12Hz，角分辨率约 0.5°） -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_gpu_laser.so" name="gazebo_ros_laser_controller">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <!-- RGB相机（用于可视化视锥） -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>2.094</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.001</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="rgb_camera_controller">
        <alwaysOn>true</alwaysOn>
        <updateRate>15.0</updateRate>
        <cameraName>rgb_camera</cameraName>
        <frameName>camera_link</frameName>
        <imageTopicName>/camera/rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>/camera/rgb/camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>
  <!-- 平面移动插件，直接控制底盘实现全向运动 -->
  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="planar_move">
      <robotNamespace>/</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <cmdTimeout>0.5</cmdTimeout>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishTf>true</publishTf>
      <odometryRate>20.0</odometryRate>
      <maxVelX>0.6</maxVelX>
      <maxVelY>0.6</maxVelY>
      <maxVelTheta>2.0</maxVelTheta>
    </plugin>
  </gazebo>
</robot>

