    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin rpy="0 0 0" xyz="-0.1295 0.1355 0.0375"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="wheel_rr">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0375"/>
