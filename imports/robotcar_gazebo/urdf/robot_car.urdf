    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="Invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
  </link>
  <!-- 底盘主链接 -->
  <link name="base_link">
    <inertial>
      <mass value="4.4"/>
