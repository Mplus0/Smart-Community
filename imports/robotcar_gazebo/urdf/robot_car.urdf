<robot name="robotcar">
  <!-- 坐标系由运行时 TF 提供：map->odom 由静态 TF 发布；odom->base_link 由插件发布 -->
  <!-- 虚拟根链接（解决 KDL 警告：根链接不能有惯性参数） -->
