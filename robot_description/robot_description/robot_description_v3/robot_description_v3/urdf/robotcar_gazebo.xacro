<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- v0.3 only establishes stable wheel/ground contact. No mecanum roller direction or controller yet. -->
  <xacro:macro name="wheel_contact" params="name">
    <gazebo reference="${name}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
  </gazebo>

  <xacro:wheel_contact name="front_left"/>
  <xacro:wheel_contact name="front_right"/>
  <xacro:wheel_contact name="rear_left"/>
  <xacro:wheel_contact name="rear_right"/>
</robot>
