<?xml version="1.0"?>
<robot name="robotcar" xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    Stage-2 mecanum kinematic model.
    Geometry is derived from the official base_link.STL.
    The four wheel links/joints reconstruct the wheel hierarchy that the
    SolidWorks export log attempted to create but failed to export.

    This file is for kinematic/TF verification first.  Wheel inertial,
    contact/friction and Gazebo drivetrain parameters are intentionally
    NOT guessed here; they belong to the next simulation-dynamics step.
  -->

  <!-- CAD-derived geometry, metres -->
  <xacro:property name="base_link_height" value="0.035791123" />
  <xacro:property name="wheel_x" value="0.106000002" />
  <xacro:property name="wheel_y" value="0.125000000" />
  <xacro:property name="wheel_radius" value="0.037230282" />
  <xacro:property name="wheel_width" value="0.032000005" />

  <link name="base_footprint" />

  <link name="base_link">
    <!-- Keep the official full-robot STL as the visual baseline.
         The CAD mesh origin is at ground level, while the standardized
         base_link is placed at wheel-axis height. -->
    <visual>
      <origin xyz="0 0 -${base_link_height}" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="official_mesh">
        <color rgba="1 1 1 1" />
      </material>
    </visual>

    <!-- Official inertial values are retained only as a traceable baseline.
         They describe the exported whole robot and must be revalidated before
         wheel-level Gazebo dynamics are enabled. -->
    <inertial>
      <origin xyz="-0.0718509386 0.00738215784 0.0903852328" rpy="0 0 0" />
      <mass value="0.486218814966626" />
      <inertia ixx="0.00196277727666921"
               ixy="2.50447049446755E-07"
               ixz="0.000140534767811098"
               iyy="0.00457256033711368"
               iyz="2.68618064993882E-07"
               izz="0.00493927269870476" />
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${base_link_height}" rpy="0 0 0" />
  </joint>

  <!-- Wheel links intentionally have no formal visual/collision/inertial yet.
       The official STL already contains the wheel appearance.  Use the files
       in preview/ to inspect these joints visually on Windows/Web. -->
  <xacro:macro name="wheel_link" params="name x y">
    <link name="${name}_wheel_link" />
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${name}_wheel_link" />
      <origin xyz="${x} ${y} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <!-- REP-103 convention adopted: +X forward, +Y left, +Z up. -->
  <xacro:wheel_link name="front_left"  x="${ wheel_x}" y="${ wheel_y}" />
  <xacro:wheel_link name="front_right" x="${ wheel_x}" y="${-wheel_y}" />
  <xacro:wheel_link name="rear_left"   x="${-wheel_x}" y="${ wheel_y}" />
  <xacro:wheel_link name="rear_right"  x="${-wheel_x}" y="${-wheel_y}" />

</robot>
