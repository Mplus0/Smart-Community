<?xml version="1.0"?>
<!--
  Web-viewer helper.
  Upload this file together with meshes/base_link.STL when the viewer supports
  relative mesh resources. The ROS runtime model remains urdf/robotcar.urdf.xacro.
-->
<robot name="robotcar_web_preview">
  <material name="official_white">
    <color rgba="1 1 1 1"/>
  </material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base_link.STL"/>
      </geometry>
      <material name="official_white"/>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
