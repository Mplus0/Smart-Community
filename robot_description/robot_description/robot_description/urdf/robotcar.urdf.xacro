<?xml version="1.0"?>
<robot name="robotcar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Smart-Community robot geometry baseline.

    Source of truth for this first clean version:
      official package: mowen
      official runtime URDF: urdf/mowen.urdf
      official visual mesh: meshes/base_link.STL

    Important:
      1. This file intentionally does NOT invent wheel, LiDAR, camera or IMU poses.
      2. The physical parameters below are copied from the official mowen.urdf
         and should be re-verified against the real robot before high-fidelity dynamics.
      3. Gazebo motion/sensor plugins belong in robot_gazebo, not in this geometry baseline.
  -->

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <material name="official_white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- Ground-projected reference frame. -->
  <link name="${prefix}base_footprint"/>

  <!-- Complete official robot CAD mesh. -->
  <link name="${prefix}base_link">
    <inertial>
      <!-- Copied verbatim from the official mowen.urdf. -->
      <origin xyz="-0.0718509386127836 0.00738215784490541 0.126176355791491"
              rpy="0 0 0"/>
      <mass value="0.486218814966626"/>
      <inertia ixx="0.00196277727666921"
               ixy="2.50447049446755E-07"
               ixz="0.000140534767811098"
               iyy="0.00457256033711368"
               iyz="2.68618064993882E-07"
               izz="0.00493927269870476"/>
    </inertial>

    <visual name="official_cad_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL"/>
      </geometry>
      <material name="official_white"/>
    </visual>

    <!--
      Kept identical to the official runtime URDF for the baseline model.
      Before physics-heavy Gazebo work, consider replacing this high-poly mesh
      collision with simple primitives in a separately reviewed revision.
    -->
    <collision name="official_cad_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!--
    The official gazebo.launch spawns mowen.urdf, where this joint origin is zero.
    We therefore use that active runtime definition rather than the inconsistent
    +0.0815 m value found in the supplied legacy mowen.urdf.xacro.
  -->
  <joint name="${prefix}base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    TODO after real-robot measurement / official confirmation:
      - front_left_wheel / front_right_wheel
      - rear_left_wheel / rear_right_wheel
      - lidar_link
      - camera_link / camera_optical_frame
      - imu_link (if required by the actual platform)
  -->

</robot>
