<launch>
  <arg name="python" default="python3" />
  <arg name="ros_python_path" default="/opt/ros/noetic/lib/python3/dist-packages" />
  <arg name="model" default="$(find robot_perception)/models/person_best.pt" />
  <arg name="device" default="0" />
  <arg name="input_topic" default="/camera/color/image_raw" />
  <arg name="image_topic" default="/perception/person_image" />
  <arg name="json_topic" default="/perception/person_detections_json" />
  <arg name="confidence" default="0.25" />
  <arg name="imgsz" default="640" />
  <arg name="max_rate" default="5.0" />
  <node pkg="robot_perception" type="person_detection_node.py" name="person_detection" output="screen" launch-prefix="$(arg python)">
    <env name="PYTHONPATH" value="$(arg ros_python_path):$(optenv PYTHONPATH)" />
    <param name="model" value="$(arg model)" />
    <param name="device" value="$(arg device)" />
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="json_topic" value="$(arg json_topic)" />
    <param name="confidence" value="$(arg confidence)" type="double" />
    <param name="imgsz" value="$(arg imgsz)" type="int" />
    <param name="max_rate" value="$(arg max_rate)" type="double" />
  </node>
</launch>
