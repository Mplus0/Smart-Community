<launch>

  <!-- YOLOv5 检测启动文件 -->
  <param name="yolov5_path" value="$(find yolov5_ros)/yolov5"/>
  <param name="use_cpu"     value="true"/>

  <!-- 可选：离线图片发布节点（无 Gazebo 时用于测试） -->
  <!-- <node pkg="photo_service" type="publish_image.py" name="image_publisher" output="screen"/> -->

  <!-- YOLOv5 ROS 检测节点 -->
  <node pkg="yolov5_ros" type="yolo_v5.py" name="yolov5_ros" output="screen">
    <param name="weight_path"   value="$(find yolov5_ros)/weights/shequ.pt"/>
    <param name="image_topic"   value="/kinect/rgb/image_raw"/>
    <param name="pub_topic"     value="/yolov5/BoundingBoxes"/>
    <param name="camera_frame"  value="kinect_frame_optical"/>
    <param name="conf"          value="0.3"/>
  </node>

</launch>
