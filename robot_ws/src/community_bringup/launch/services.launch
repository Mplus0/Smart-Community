<launch>
  <arg name="data_dir" default="$(env HOME)/.ros/community"/>
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <include file="$(find community_perception)/launch/main_detector.launch">
    <arg name="save_enabled" value="true"/><arg name="save_dir" value="$(arg data_dir)/detections"/>
  </include>
  <include file="$(find community_perception)/launch/ocr_server.launch"><arg name="save_dir" value="$(arg data_dir)/ocr"/></include>
  <include file="$(find community_perception)/launch/fall_counter.launch"/>
  <include file="$(find community_mission)/launch/speech.launch"/>
  <include file="$(find community_mission)/launch/recorder.launch">
    <arg name="data_dir" value="$(arg data_dir)"/><arg name="image_topic" value="$(arg image_topic)"/>
  </include>
</launch>
