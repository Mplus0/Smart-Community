<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="map" default="$(find community_bringup)/maps/map.yaml" />
  <arg name="navigation_map" default="$(find community_bringup)/maps/map_nav.yaml" />
  <!-- 原地图保留 /map 和 /static_map，供 AMCL 定位使用。 -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map)" />
  <group ns="navigation">
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg navigation_map)">
      <param name="frame_id" value="map" />
      <remap from="map" to="/navigation_map" />
      <remap from="map_metadata" to="/navigation_map_metadata" />
    </node>
  </group>
  <include file="$(find community_bringup)/launch/amcl.launch" />
  <include file="$(find community_bringup)/launch/move_base.launch" />
  <param name="robot_description" textfile="$(find robot_description)/urdf/mowen.urdf" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" output="screen">
    <rosparam command="load" file="$(find community_bringup)/config/navigation/ekf.yaml" />
    <param name="odom0" value="/odom_raw" />
    <param name="imu0" value="/wit/imu" />
    <param name="odom_frame" value="odom" />
    <param name="world_frame" value="odom" />
    <param name="base_link_frame" value="base_footprint" />
    <remap from="odometry/filtered" to="/odom" />
  </node>
</launch>
