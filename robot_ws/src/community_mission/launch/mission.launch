<launch>
  <arg name="navigation_only" default="false" />
  <arg name="green_confirm_frames" default="" />
  <arg name="traffic_light_timeout" default="" />
  <arg name="navigation_retries" default="" />
  <arg name="navigation_cancel_timeout" default="" />
  <arg name="goal_timeout" default="" />
  <arg name="data_dir" default="$(env HOME)/.ros/community" />
  <arg name="image_topic" default="/usb_cam/image_raw" />
  <arg name="route" default="$(find community_mission)/config/route.yaml" />
  <node pkg="community_mission" type="mission_node.py" name="community_mission" output="screen" required="true">
    <rosparam command="load" file="$(find community_mission)/config/recognition_rules.yaml" />
    <rosparam command="load" file="$(find community_mission)/config/runtime.yaml" />
    <param if="$(eval arg('green_confirm_frames') != '')" name="green_confirm_frames" type="int" value="$(arg green_confirm_frames)" />
    <param if="$(eval arg('traffic_light_timeout') != '')" name="traffic_light_timeout" type="double" value="$(arg traffic_light_timeout)" />
    <param if="$(eval arg('navigation_retries') != '')" name="navigation_retries" type="int" value="$(arg navigation_retries)" />
    <param if="$(eval arg('navigation_cancel_timeout') != '')" name="navigation_cancel_timeout" type="double" value="$(arg navigation_cancel_timeout)" />
    <param if="$(eval arg('goal_timeout') != '')" name="goal_timeout" type="double" value="$(arg goal_timeout)" />
    <rosparam command="load" file="$(arg route)" />
    <param name="navigation_only" type="bool" value="$(arg navigation_only)" />
    <param name="data_dir" value="$(arg data_dir)" />
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="planner_namespace" value="/move_base/DWAPlannerROS" />
  </node>
</launch>
