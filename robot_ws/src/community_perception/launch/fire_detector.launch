<?xml version="1.0"?>
<launch>
    <arg name="conf_threshold" default="0.9" />
    <arg name="iou_threshold" default="0.4" />
    <arg name="save_enabled" default="false" />
    <arg name="save_dir" default="$(env HOME)/detection_results/fire" />
    
    <node name="fire_detector" pkg="community_perception" type="yolo_detector_service.py" output="screen">
        <param name="model_path" value="$(find community_perception)/models/fire.onnx" />
        <param name="model_name" value="fire_detector" />
        <param name="conf_threshold" value="$(arg conf_threshold)" />
        <param name="iou_threshold" value="$(arg iou_threshold)" />
        <param name="save_enabled" value="$(arg save_enabled)" />
        <param name="save_dir" value="$(arg save_dir)" />
        
        <rosparam param="class_names">
            ["fire"]
        </rosparam>
        
        <rosparam param="save_classes">[0]</rosparam>
        
        <param name="service_name" value="/fire_detector/detect" />
    </node>
</launch>