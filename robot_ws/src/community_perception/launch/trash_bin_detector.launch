<?xml version="1.0"?>
<launch>
    <arg name="conf_threshold" default="0.5" />
    <arg name="iou_threshold" default="0.4" />
    <arg name="save_enabled" default="false" />
    <arg name="save_dir" default="$(env HOME)/detection_results/trash_bin" />
    
    <node name="trash_bin_detector" pkg="community_perception" type="yolo_detector_service.py" output="screen">
        <param name="model_path" value="$(find community_perception)/models/tong.onnx" />
        <param name="model_name" value="trash_bin_detector" />
        <param name="conf_threshold" value="$(arg conf_threshold)" />
        <param name="iou_threshold" value="$(arg iou_threshold)" />
        <param name="save_enabled" value="$(arg save_enabled)" />
        <param name="save_dir" value="$(arg save_dir)" />
        
        <!-- 八个垃圾桶类别 -->
        <rosparam param="class_names">
            ["blue_close", "blue_open", "gray_close", "gray_open",
             "green_close", "green_open", "red_close", "red_open",]       
        </rosparam>
        
        <rosparam param="save_classes">[0, 1, 2, 3, 4, 5, 6, 7]</rosparam>
        
        <param name="service_name" value="/trash_bin_detector/detect" />
    </node>
</launch>