<launch>
  <arg name="publish_rate" default="9.0"/>
  <arg name="frame_id" default="thermal_camera_optical_frame"/>
  <node name="thermal_camera" pkg="community_perception" type="thermal_camera.py" output="screen">
    <param name="publish_rate" value="$(arg publish_rate)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>
</launch>
