<?xml version="1.0"?>
<launch>
    <arg name="conf_threshold" default="0.85" />
    <arg name="iou_threshold" default="0.4" />
    <arg name="save_enabled" default="false" />
    <arg name="save_dir" default="$(env HOME)/detection_results/bicycle" />
    
    <node name="bicycle_detector" pkg="community_perception" type="yolo_detector_service.py" output="screen">
        <param name="model_path" value="$(find community_perception)/models/byc.onnx" />
        <param name="model_name" value="bicycle_detector" />
        <param name="conf_threshold" value="$(arg conf_threshold)" />
        <param name="iou_threshold" value="$(arg iou_threshold)" />
        <param name="save_enabled" value="$(arg save_enabled)" />
        <param name="save_dir" value="$(arg save_dir)" />
        
        <!-- 两个类别：站立和倒下 -->
        <rosparam param="class_names">
            ["stand", "fall"]
        </rosparam>
        
        <rosparam param="save_classes">[0, 1]</rosparam>
        
        <param name="service_name" value="/bicycle_detector/detect" />
    </node>
</launch>