<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Gazebo Classic simulation strategy for the mecanum chassis.

    1. robotcar_planar_move drives ONLY the final Gazebo base_footprint link.
       It does not use Model::SetLinearVel / Model::SetAngularVel, so it does
       not overwrite wheel-link velocities.
    2. gazebo_ros_control + wheel velocity controller keeps all four wheel
       joints rotating according to the real mecanum inverse kinematics.
    3. Wheel collisions provide low isotropic ground contact only; no fdir1
       roller approximation is used.

    The official CAD-derived inertia is preserved.  The custom planar plugin
    reads base_footprint's CoG directly from Gazebo and compensates its linear
    velocity so /cmd_vel remains referenced to the base_footprint origin.
  -->

  <xacro:property name="wheel_mu" value="0.05"/>
  <xacro:property name="contact_kp" value="1000000.0"/>
  <xacro:property name="contact_kd" value="10.0"/>

  <xacro:macro name="wheel_contact" params="name">
    <gazebo reference="${name}_wheel_link">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu}</mu2>
      <kp>${contact_kp}</kp>
      <kd>${contact_kd}</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
  </gazebo>

  <xacro:wheel_contact name="front_left"/>
  <xacro:wheel_contact name="front_right"/>
  <xacro:wheel_contact name="rear_left"/>
  <xacro:wheel_contact name="rear_right"/>

  <gazebo>
    <!-- Four physical wheel joints remain controllable for rotation/odometry. -->
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>

    <!--
      Stable holonomic chassis motion referenced to base_footprint.
      The plugin drives only base_footprint and publishes no odometry or TF;
      formal odometry remains /wheel/odom and will later be fused with IMU.
    -->
    <plugin name="robotcar_planar_move" filename="librobotcar_planar_move.so">
      <robotNamespace>/</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <baseLink>base_footprint</baseLink>
      <cmdTimeout>0.5</cmdTimeout>
    </plugin>
  </gazebo>
</robot>
