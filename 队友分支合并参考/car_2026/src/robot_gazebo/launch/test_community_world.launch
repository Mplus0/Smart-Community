<launch>
  <arg name="world_name" default="$(find robot_gazebo)/worlds/community.world" />
  <arg name="gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="use_sim_time" default="true" />

  <!-- community.world uses flat model:// names for nested model folders. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find robot_gazebo)/models:$(find robot_gazebo)/models/people:$(find robot_gazebo)/models/non-people:$(optenv GAZEBO_MODEL_PATH)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
  </include>
</launch>
