<?xml version="1.0"?>
<sdf version="1.6">
  <model name="thin_plate">
    <static>false</static>

    <link name="plate_link">
      <!-- 抬到地面上方，使底面贴地 -->
      <pose>0 0 0.075 0 0 0</pose>

      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00039375</ixx>
          <iyy>0.00033750</iyy>
          <izz>0.00006375</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="plate_collision">
        <geometry>
          <box>
            <size>0.002 0.05 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="plate_visual">
        <geometry>
          <box>
            <size>0.002 0.05 0.15</size>
          </box>
        </geometry>
        <!-- 不指定 material，使用 Gazebo 默认颜色 -->
      </visual>
    </link>
  </model>
</sdf>