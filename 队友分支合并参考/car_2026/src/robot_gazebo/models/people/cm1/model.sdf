<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cm1">
    <static>true</static>
    <pose>0 0 0.075 0 0 0</pose>
    <link name="cm1">

      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.005 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- ① 主体：灰色 box（只改外观，碰撞体不变） -->
      <visual name="body">
        <geometry>
          <box>
            <size>0.05 0.005 0.15</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>

      <!-- ② 只在 +Y 这一面贴图（plane 是单面的） -->
      <visual name="face_texture">
        <!-- Y 稍微外移 0.00001，避免与 box 表面"闪面"(z-fighting) -->
        <pose>0 0.00251 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>1 0 0</normal>
            <size>0.05 0.15</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://cm1/materials/scripts/cm1.material</uri>
            <uri>model://cm1/materials/textures/cm1.png</uri>
            <name>cm1</name>
          </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>