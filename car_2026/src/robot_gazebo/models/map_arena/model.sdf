<?xml version="1.0"?>
<sdf version="1.6">
  <model name="map_arena">
    <static>true</static>
    <!-- Ground plane with texture 4.2x4.2m -->
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <collision name="ground_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.2 4.2</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="ground_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.2 4.2</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://map_arena/materials/scripts</uri>
            <uri>model://map_arena/materials/textures</uri>
            <name>MapArena/MapFloor</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- Walls around the edges -->
    <!-- default: thickness 0.05m, height 0.30m -->
    <link name="wall_north">
      <pose>0 2.1 0.15 0 0 0</pose>
      <collision name="col">
        <geometry>
          <box>
            <size>4.2 0.05 0.30</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>4.2 0.05 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wall_south">
      <pose>0 -2.1 0.15 0 0 0</pose>
      <collision name="col">
        <geometry>
          <box>
            <size>4.2 0.05 0.30</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>4.2 0.05 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wall_east">
      <pose>2.1 0 0.15 0 0 0</pose>
      <collision name="col">
        <geometry>
          <box>
            <size>0.05 4.2 0.30</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>0.05 4.2 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wall_west">
      <pose>-2.1 0 0.15 0 0 0</pose>
      <collision name="col">
        <geometry>
          <box>
            <size>0.05 4.2 0.30</size>
          </box>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <box>
            <size>0.05 4.2 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
