<?xml version="1.0"?>
<robot name="robotcar_sensor_tf_skeleton">
  <material name="gray"><color rgba="0.45 0.45 0.45 0.75"/></material>
  <material name="blue"><color rgba="0.2 0.45 0.9 1"/></material>
  <material name="green"><color rgba="0.25 0.75 0.3 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>
  <material name="red"><color rgba="0.9 0.2 0.2 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.30 0.18 0.08"/></geometry><material name="gray"/></visual>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.037230282"/></joint>

  <link name="laser_link">
    <visual><geometry><cylinder radius="0.03" length="0.035"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.09199999 0 0.122011877"/></joint>

  <link name="camera_link">
    <visual><geometry><box size="0.025 0.085 0.025"/></geometry><material name="green"/></visual>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.13499999 0 0.060287877"/></joint>

  <link name="camera_optical_frame">
    <visual><geometry><sphere radius="0.008"/></geometry><material name="red"/></visual>
  </link>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/></joint>

  <link name="imu_link">
    <visual><geometry><box size="0.035 0.025 0.008"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="-0.043 0 0.107799877"/></joint>
</robot>
