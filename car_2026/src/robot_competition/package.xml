<?xml version="1.0"?>
<package format="2">
  <name>robot_competition</name>
  <version>0.1.0</version>
  <description>Waypoint navigation, bounded perception tasks and persistent competition results.</description>
  <maintainer email="maintainer@example.com">Smart Community Maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export/>
</package>
