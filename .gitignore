# Mission evidence is generated in the mounted workspace, never source control.
simulation_ws/results/
robot_ws/results/
simulation_ws/src/robot_gazebo/results/*
!simulation_ws/src/robot_gazebo/results/generated_plates.json
# The existing tracked generated_plates.json remains with its scene textures.
# Recorder advisory locks are created on demand; do not ignore dependency lockfiles.
simulation_ws/**/*.yaml.lock
robot_ws/**/*.yaml.lock
# Local camera captures, training caches and new training runs.
simulation_ws/datasets/
robot_ws/datasets/
datasets/**/*.cache
yolo_train/datasets/**/*.cache
yolo_train/runs/
yolo_train/results/*
!yolo_train/results/traffic_light/
yolo_train/results/traffic_light/*
!yolo_train/results/traffic_light/yolo11n_baseline/
yolo_train/results/traffic_light/yolo11n_baseline/*
!yolo_train/results/traffic_light/yolo11n_baseline/weights/
yolo_train/results/traffic_light/yolo11n_baseline/weights/*
!yolo_train/results/traffic_light/yolo11n_baseline/weights/best.pt
!yolo_train/results/traffic_light/yolo11n_baseline/weights/last.pt
/runs/
/results/
# Existing tracked training weights remain versioned.

