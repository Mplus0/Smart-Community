# The existing tracked generated_plates.json remains with its scene textures.
# Recorder advisory locks are created on demand; do not ignore dependency lockfiles.
car_2026/**/*.yaml.lock
# Local camera captures, training caches and new training runs.
car_2026/datasets/
datasets/**/*.cache
/runs/
/results/
# Existing tracked training evidence and weights remain versioned.

# Locally copied traffic-light classifier; deploy separately (or explicitly use Git LFS).
car_2026/src/robot_perception/models/traffic_light_best.pt
